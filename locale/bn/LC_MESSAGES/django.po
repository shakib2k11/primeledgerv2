#: accounting/api.py:89
msgid "Provide either a debit or a credit amount."
msgstr "একটি ডেবিট বা ক্রেডিট পরিমাণ প্রদান করুন."

#: accounting/api.py:114 accounting/api.py:149 accounting/models.py:217
#: operations/models.py:85
msgid "This fiscal period is locked."
msgstr "এই আর্থিক সময়কাল লক করা হয়."

#: accounting/api.py:116 accounting/models.py:212
msgid "Journal entry date must fall within its fiscal period."
msgstr "জার্নাল এন্ট্রি তারিখ তার আর্থিক সময়ের মধ্যে পড়া আবশ্যক."

#: accounting/api.py:119 accounting/forms.py:125 accounting/models.py:220
msgid "A journal entry requires at least two lines."
msgstr "একটি জার্নাল এন্ট্রির জন্য কমপক্ষে দুটি লাইন প্রয়োজন।"

#: accounting/api.py:147
msgid "Posted journal entries cannot be edited."
msgstr "পোস্ট করা জার্নাল এন্ট্রি সম্পাদনা করা যাবে না."

#: accounting/api.py:184 accounting/models.py:345
msgid "Financial vouchers cannot be edited after creation."
msgstr "আর্থিক ভাউচার তৈরি করার পরে সম্পাদনা করা যাবে না।"

#: accounting/api.py:337 accounting/forms.py:223
#: accounting/infrastructure/repositories.py:228
msgid "Expense date cannot be in the future."
msgstr "খরচ তারিখ ভবিষ্যতে হতে পারে না."

#: accounting/api.py:340
msgid "Paid expenses require a payment account."
msgstr "প্রদত্ত খরচ একটি অর্থপ্রদান অ্যাকাউন্ট প্রয়োজন."

#: accounting/api.py:342
msgid "Pay-later expenses require a payee."
msgstr "পে-পরে খরচের জন্য একজন প্রাপক প্রয়োজন।"

#: accounting/forms.py:33
msgid "This account code is already in use."
msgstr "এই অ্যাকাউন্ট কোড ইতিমধ্যে ব্যবহার করা হয়."

#: accounting/forms.py:40
msgid "Optional stable posting role used by automated accounting workflows."
msgstr "স্বয়ংক্রিয় অ্যাকাউন্টিং ওয়ার্কফ্লো দ্বারা ব্যবহৃত ঐচ্ছিক স্থিতিশীল পোস্টিং ভূমিকা।"

#: accounting/forms.py:56
msgid "Assign only when automated posting depends on this account."
msgstr "শুধুমাত্র তখনই বরাদ্দ করুন যখন স্বয়ংক্রিয় পোস্টিং এই অ্যাকাউন্টের উপর নির্ভর করে।"

#: accounting/forms.py:65
msgid "Active when copied"
msgstr "কপি করা হলে সক্রিয়"

#: accounting/forms.py:66
msgid "Include in template"
msgstr "টেমপ্লেট অন্তর্ভুক্ত করুন"

#: accounting/forms.py:76
msgid "Reopen the period before changing its boundary."
msgstr "এর সীমানা পরিবর্তন করার আগে পিরিয়ডটি আবার খুলুন।"

#: accounting/forms.py:130
msgid "Each line must contain either a debit or a credit amount."
msgstr "প্রতিটি লাইনে একটি ডেবিট বা ক্রেডিট পরিমাণ থাকতে হবে।"

#: accounting/forms.py:180
msgid "Required when the expense will be paid later."
msgstr "প্রয়োজন পরে যখন খরচ পরিশোধ করা হবে."

#: accounting/forms.py:192
msgid "Bill, payroll, lease, or party reference."
msgstr "বিল, বেতন, ইজারা বা পার্টির রেফারেন্স।"

#: accounting/forms.py:196
msgid "I confirm this expense should be posted to the ledger."
msgstr "আমি নিশ্চিত করছি যে এই খরচটি লেজারে পোস্ট করা উচিত।"

#: accounting/forms.py:231
msgid "Select the account used to pay."
msgstr "অর্থ প্রদানের জন্য ব্যবহৃত অ্যাকাউন্ট নির্বাচন করুন।"

#: accounting/forms.py:234
msgid "Select the person or organization to be paid."
msgstr "অর্থ প্রদান করা ব্যক্তি বা সংস্থা নির্বাচন করুন।"

#: accounting/forms.py:249
msgid "I confirm this payment should be posted."
msgstr "আমি নিশ্চিত যে এই অর্থ প্রদান পোস্ট করা উচিত."

#: accounting/forms.py:271 accounting/infrastructure/repositories.py:377
#: operations/api.py:115 operations/forms.py:246 operations/forms.py:305
msgid "Payment date cannot be in the future."
msgstr "পেমেন্ট তারিখ ভবিষ্যতে হতে পারে না."

#: accounting/forms.py:273 accounting/infrastructure/repositories.py:389
msgid "Payment date cannot precede the expense date."
msgstr "অর্থপ্রদানের তারিখ ব্যয়ের তারিখের আগে হতে পারে না।"

#: accounting/infrastructure/repositories.py:96
#, python-format
msgid "Template conflicts must be resolved first: %(conflicts)s"
msgstr "টেমপ্লেট দ্বন্দ্ব প্রথমে সমাধান করতে হবে: %(conflicts)s"

#: accounting/infrastructure/repositories.py:224
msgid "This expense request key was already used with different details."
msgstr "এই ব্যয়ের অনুরোধ কীটি ইতিমধ্যেই বিভিন্ন বিবরণের সাথে ব্যবহার করা হয়েছে।"

#: accounting/infrastructure/repositories.py:236
msgid "No fiscal period covers the expense date."
msgstr "কোনো আর্থিক সময়কাল ব্যয়ের তারিখ কভার করে না।"

#: accounting/infrastructure/repositories.py:238
msgid "The fiscal period covering the expense date is locked."
msgstr "ব্যয়ের তারিখ কভার করা আর্থিক সময়কাল লক করা আছে।"

#: accounting/infrastructure/repositories.py:246
msgid "Select an active expense account for this business."
msgstr "এই ব্যবসার জন্য একটি সক্রিয় খরচ অ্যাকাউন্ট নির্বাচন করুন."

#: accounting/infrastructure/repositories.py:253
msgid "Select an active payee for this business."
msgstr "এই ব্যবসার জন্য একজন সক্রিয় প্রাপক নির্বাচন করুন।"

#: accounting/infrastructure/repositories.py:265
#: accounting/infrastructure/repositories.py:398
msgid "Select an active Cash, Bank, or Mobile Financial Services account."
msgstr "একটি সক্রিয় নগদ, ব্যাংক, বা মোবাইল আর্থিক পরিষেবা অ্যাকাউন্ট নির্বাচন করুন৷"

#: accounting/infrastructure/repositories.py:269 accounting/models.py:563
msgid "A pay-later expense requires a payee."
msgstr "একটি পে-পরে খরচের জন্য একজন প্রাপক প্রয়োজন।"

#: accounting/infrastructure/repositories.py:276
msgid "An active Accounts Payable account is required."
msgstr "একটি সক্রিয় অ্যাকাউন্ট প্রদেয় অ্যাকাউন্ট প্রয়োজন।"

#: accounting/infrastructure/repositories.py:278
msgid "Select whether this expense is paid now or payable later."
msgstr "এই খরচ এখন পরিশোধ করা হবে নাকি পরে পরিশোধ করা হবে তা নির্বাচন করুন।"

#: accounting/infrastructure/repositories.py:280
msgid "Expense amount must be greater than zero."
msgstr "ব্যয়ের পরিমাণ অবশ্যই শূন্যের বেশি হতে হবে।"

#: accounting/infrastructure/repositories.py:283
msgid "Expense description is required."
msgstr "ব্যয় বিবরণ প্রয়োজন."

#: accounting/infrastructure/repositories.py:373
msgid "This expense payment key was already used with different details."
msgstr "এই খরচ পেমেন্ট কী ইতিমধ্যেই বিভিন্ন বিবরণের সাথে ব্যবহার করা হয়েছে।"

#: accounting/infrastructure/repositories.py:387
msgid "Only pay-later expenses can receive allocated payments."
msgstr "শুধুমাত্র পে-পরে খরচ বরাদ্দকৃত অর্থ গ্রহণ করতে পারে।"

#: accounting/infrastructure/repositories.py:406
#: operations/infrastructure/repositories.py:329
#: operations/infrastructure/repositories.py:535
msgid "No fiscal period covers the payment date."
msgstr "কোনো আর্থিক সময়কাল অর্থপ্রদানের তারিখ কভার করে না।"

#: accounting/infrastructure/repositories.py:408
#: operations/infrastructure/repositories.py:331
#: operations/infrastructure/repositories.py:537
msgid "The fiscal period covering the payment date is locked."
msgstr "অর্থপ্রদানের তারিখ কভার করার সময়কাল লক করা আছে।"

#: accounting/infrastructure/repositories.py:414
#: operations/infrastructure/repositories.py:341
#: operations/infrastructure/repositories.py:547
msgid "Payment amount must be greater than zero."
msgstr "অর্থপ্রদানের পরিমাণ অবশ্যই শূন্যের বেশি হতে হবে।"

#: accounting/infrastructure/repositories.py:417 operations/forms.py:253
#: operations/forms.py:312 operations/infrastructure/repositories.py:346
