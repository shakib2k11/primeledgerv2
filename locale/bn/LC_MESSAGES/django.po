msgstr "কন্ট্রা"

#: accounting/models.py:302
msgid "Return"
msgstr "প্রত্যাবর্তন"

#: accounting/models.py:321
msgid "Voucher and journal entry must belong to the same business."
msgstr "ভাউচার এবং জার্নাল এন্ট্রি অবশ্যই একই ব্যবসার অন্তর্গত।"

#: accounting/models.py:323
msgid "Voucher and party must belong to the same business."
msgstr "ভাউচার এবং পার্টি অবশ্যই একই ব্যবসার অন্তর্গত।"

#: accounting/models.py:325
msgid "Voucher and journal entry dates must match."
msgstr "ভাউচার এবং জার্নাল এন্ট্রি তারিখ অবশ্যই মিলবে।"

#: accounting/models.py:327
msgid "A voucher must reference a posted journal entry."
msgstr "একটি ভাউচার অবশ্যই একটি পোস্ট করা জার্নাল এন্ট্রি উল্লেখ করতে হবে।"

#: accounting/models.py:340
msgid "Voucher total must match the party-facing journal amount."
msgstr "ভাউচারের মোট পরিমাণ অবশ্যই পার্টি-মুখী জার্নালের পরিমাণের সাথে মিলতে হবে।"

#: accounting/models.py:349
msgid "Financial vouchers cannot be deleted."
msgstr "আর্থিক ভাউচার মুছে ফেলা যাবে না."

#: accounting/models.py:402
msgid "Money receipt and voucher must belong to the same business."
msgstr "অর্থের রসিদ এবং ভাউচার অবশ্যই একই ব্যবসার অন্তর্গত।"

#: accounting/models.py:404
